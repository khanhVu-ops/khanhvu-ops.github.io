# Copy to .env (gitignored) and fill in. Never commit .env or anything in .secrets/.

# OAuth "Desktop app" client JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS=.secrets/youtube-client.json
# Where `upload.py auth` stores the refresh token. Created on first sign-in.
YOUTUBE_TOKEN_FILE=.secrets/youtube-token.json
# Uploads are refused if the signed-in account's channel is not this one (KV Apps).
YOUTUBE_EXPECTED_CHANNEL_ID=UC7kW-0SrYs4FGm1LFT9zJRw
